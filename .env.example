# Notion
NOTION_API_KEY=
NOTION_ROOT_PAGE_ID=

# GitHub
GITHUB_TOKEN=
# 쉼표로 구분한 owner/repo 목록 (scripts/ingest_github_code.py)
GITHUB_REPOS=

# Voyage AI
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
VOYAGE_RERANK_MODEL=rerank-2.5-lite
# scripts/ingest_github_code.py가 저장 시 하드코딩해서 쓰는 모델과 반드시 같아야 함
VOYAGE_CODE_MODEL=voyage-code-4

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# PostgreSQL (pgvector)
POSTGRES_USER=notion_rag
POSTGRES_PASSWORD=notion_rag
POSTGRES_DB=notion_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Retrieval
TOP_K=5
RERANK_FETCH_K=20
BM25_FETCH_K=20
RRF_K=60
GITHUB_CODE_TOP_K=10
# 프롬프트에 이어붙일 컨텍스트 글자 수 예산(대략치, 정확한 토큰 수 아님).
# 비워두면(기본값) 예산 제한 없이 청크를 전부 이어붙인다 — 코드 청크가 많이
# 섞이는 질문에서 프롬프트가 너무 길어진다 싶으면 상황에 맞게 조정할 것.
MAX_CONTEXT_CHARS=12000
